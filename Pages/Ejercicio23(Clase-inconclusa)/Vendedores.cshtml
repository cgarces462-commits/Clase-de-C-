@page
@model CalculadoraWeb.Pages.VendedoresModel
@using System.Globalization
@{
    ViewData["Title"] = "Comisiones de vendedores";
    var cop = new CultureInfo("es-CO");
    int i = 0;
}

<h2>Comisiones de vendedores</h2>
<p>Cada vendedor realiza 3 ventas por semana y recibe su sueldo base más 10% de comisión sobre sus ventas.</p>

@* Mensaje de error general (por ejemplo, N negativo) *@
<div asp-validation-summary="All" class="text-danger"></div>

@* Pedir n *@
<form method="get" class="mb-4">
    <label for="N">Cantidad de vendedores (n):</label>
    <input type="number" id="N" name="N" min="1" max="100" value="@(Model.N > 0 ? Model.N : "")" required />
    <button type="submit">Generar formulario</button>
</form>

@* Datos de cada vendedor *@
@if (Model.Vendedores.Count > 0)
{
    <form method="post">
        <input type="hidden" name="N" value="@Model.N" />

        <table class="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nombre</th>
                    <th>Sueldo base</th>
                    <th>Venta 1</th>
                    <th>Venta 2</th>
                    <th>Venta 3</th>
                    @if (Model.Calculado)
                    {
                        <th>Total ventas</th>
                        <th>Comisión (10%)</th>
                        <th>Sueldo total</th>
                    }
                </tr>
            </thead>
            <tbody>
                @while (i < Model.Vendedores.Count)
                {
                    <tr>
                        <td>@(i + 1)</td>
                        <td><input asp-for="Vendedores[i].Nombre" placeholder="Vendedor @(i + 1)" /></td>
                        <td><input asp-for="Vendedores[i].SueldoBase" type="number" step="any" min="0" required /></td>
                        <td><input asp-for="Vendedores[i].Venta1" type="number" step="any" min="0" required /></td>
                        <td><input asp-for="Vendedores[i].Venta2" type="number" step="any" min="0" required /></td>
                        <td><input asp-for="Vendedores[i].Venta3" type="number" step="any" min="0" required /></td>
                        @if (Model.Calculado)
                        {
                            <td>@Model.Vendedores[i].TotalVentas.ToString("C0", cop)</td>
                            <td>@Model.Vendedores[i].Comision.ToString("C0", cop)</td>
                            <td>@Model.Vendedores[i].SueldoTotal.ToString("C0", cop)</td>
                        }
                    </tr>
                    <tr>
                        <td></td>
                        <td colspan="5">
                            <span asp-validation-for="Vendedores[i].Nombre" class="text-danger"></span>
                            <span asp-validation-for="Vendedores[i].SueldoBase" class="text-danger"></span>
                            <span asp-validation-for="Vendedores[i].Venta1" class="text-danger"></span>
                            <span asp-validation-for="Vendedores[i].Venta2" class="text-danger"></span>
                            <span asp-validation-for="Vendedores[i].Venta3" class="text-danger"></span>
                        </td>
                    </tr>

                    i++;
                }
            </tbody>
        </table>

        <button type="submit">Calcular</button>
    </form>

    @if (Model.Calculado)
    {
        <hr />
        <h4>Resumen</h4>
        <p><strong>Total en comisiones:</strong> @Model.TotalComisiones.ToString("C0", cop)</p>
        <p><strong>Total a pagar (sueldos base + comisiones):</strong> @Model.TotalAPagar.ToString("C0", cop)</p>
    }
}